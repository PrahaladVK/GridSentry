        <mxCell id="n2" value="&lt;b&gt;GridSentry — System Architecture&lt;/b&gt;" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#f0f3f8;" vertex="1" parent="1"><mxGeometry x="560" y="10" width="520" height="34" as="geometry"/></mxCell><mxCell id="n3" value="★ = Planned / not yet implemented" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#9aa5b8;" vertex="1" parent="1"><mxGeometry x="560" y="42" width="520" height="20" as="geometry"/></mxCell><mxCell id="n4" value="PRESENTATION LAYER — React (frontend/src)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#39435a;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;fontColor=#9aa5b8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="75" width="1560" height="185" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Home&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Live status&lt;br&gt;Today&#x27;s usage&lt;br&gt;Open anomalies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Forecast&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;1h / 24h / 7d toggle&lt;br&gt;Predicted vs. actual&lt;br&gt;SHAP driver bars&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="290" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Anomalies&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Flagged events&lt;br&gt;Acknowledge / resolve&lt;br&gt;Severity + method&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="550" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Recommendations&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Rule-based tips&lt;br&gt;Priority tags&lt;br&gt;Grouped per floor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Model Lab&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Training run history&lt;br&gt;Ensemble vs. baseline&lt;br&gt;Accuracy trend&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1070" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Settings ★&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Alert thresholds&lt;br&gt;Retrain schedule&lt;br&gt;User roles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#5fb3ff;dashed=1;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1330" y="105" width="250" height="140" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;REST API — FastAPI · 127.0.0.1:8000 (CORS-enabled, loopback only)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;/forecast · /forecast/history · /anomalies · /buildings · /recommendations · /retrain · /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0e1a15;strokeColor=#39d98a;fontColor=#39d98a;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="1540" height="55" as="geometry"/></mxCell><mxCell id="n12" value="poll / request every 30-45s" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#9aa5b8;" vertex="1" parent="1"><mxGeometry x="30" y="358" width="1540" height="18" as="geometry"/></mxCell><mxCell id="n13" value="CORE ENGINE LAYER — Python worker (in-process, APScheduler-driven)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#39435a;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;fontColor=#9aa5b8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="385" width="1560" height="460" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Data Ingestion&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-style:italic&#x27;&gt;real_dataset.py&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Historical: real UCI Appliances Energy dataset (one-time CSV load)&lt;br&gt;&lt;br&gt;Live tick: replays a real reading from 7 days back + jitter, every 30s&lt;br&gt;&lt;br&gt;&lt;i&gt;No MQTT/Kafka broker — single scheduled job&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="415" width="290" height="190" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Forecasting &amp; Detection Pipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="335" y="415" width="420" height="360" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;① Feature Engineering&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;lags · rolling avg · calendar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="390" height="55" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;② Forecasting Ensemble&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;GRU + XGBoost, blended by validation RMSE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="523" width="390" height="55" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;③ Model Comparison ★&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;planned: + LightGBM, ARIMA/SVR baselines (base paper Table 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#5fb3ff;dashed=1;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="586" width="390" height="55" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;④ Anomaly Scoring&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;control-chart + autoencoder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="649" width="390" height="55" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;⑤ Recommendation Gen&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;rule engine → dashboard tip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="350" y="712" width="390" height="55" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Model Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-style:italic&#x27;&gt;forecast_service.py&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Versioned model runs (model_runs table)&lt;br&gt;&lt;br&gt;Joblib artifacts, per floor × horizon&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="775" y="415" width="240" height="150" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Retraining Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-style:italic&#x27;&gt;main.py (APScheduler)&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Nightly rolling-window retrain&lt;br&gt;Bumps model registry version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="775" y="590" width="240" height="130" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Alert Dispatcher ★&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-style:italic&#x27;&gt;planned: notifier.py&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Email/SMS on high-severity anomaly&lt;br&gt;&lt;br&gt;Rate-limited per floor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#5fb3ff;dashed=1;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1030" y="415" width="240" height="150" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Report Builder ★&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px;font-style:italic&#x27;&gt;planned&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Weekly PDF/CSV export of consumption &amp; forecast accuracy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#5fb3ff;dashed=1;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1030" y="590" width="240" height="130" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Shared State&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;20s forecast cache per floor × horizon&lt;br&gt;&lt;br&gt;Active model version&lt;br&gt;&lt;br&gt;Retrain-in-progress flag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1c1305;strokeColor=#e3c565;dashed=1;fontColor=#e3c565;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1285" y="415" width="280" height="305" as="geometry"/></mxCell><mxCell id="n26" value="DATA LAYER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#39435a;verticalAlign=top;align=left;spacingTop=6;spacingLeft=10;fontColor=#9aa5b8;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="1560" height="175" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;gridsentry.db (via SQLAlchemy)&lt;br&gt;&gt; readings · forecasts&lt;br&gt;&gt; anomalies · model_runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="30" y="885" width="375" height="130" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Model Store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;artifacts/models/&lt;br&gt;floor{N}_{horizon}.joblib&lt;br&gt;Loaded via joblib&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="415" y="885" width="375" height="130" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Historical Weather&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;Real T_out / RH_out,&lt;br&gt;embedded in the dataset&lt;br&gt;Per-hour climatology lookup — no external API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="885" width="375" height="130" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;External Source&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9.5px&#x27;&gt;UCI &quot;Appliances Energy Prediction&quot;&lt;br&gt;dataset (real, public)&lt;br&gt;One-time download → seeds SQLite&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#151b26;strokeColor=#39435a;fontColor=#f0f3f8;align=center;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1185" y="885" width="375" height="130" as="geometry"/></mxCell><mxCell id="n31" value="Legend:" style="text;html=1;fontSize=10.5;align=center;verticalAlign=middle;fontColor=#9aa5b8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="1055" width="40" height="30" as="geometry"/></mxCell><mxCell id="n32" value="Existing component" style="rounded=1;whiteSpac